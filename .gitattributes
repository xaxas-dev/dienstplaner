# Default: Auto-Erkennung, normalisiert auf LF im Repo
* text=auto eol=lf

# Eindeutig Text
*.py        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.html      text eol=lf
*.css       text eol=lf

# Windows-spezifisch: CRLF behalten
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binär
*.png       binary
*.jpg       binary
*.pdf       binary
*.xlsx      binary
*.sqlite    binary
*.db        binary